#[import(cc = "thorin")] fn cuda_launch_device(_dev: i32, _grid: (i32, i32, i32), _block: (i32, i32, i32), _body: fn() -> ()) -> ();

fn @round_up(n : i32, r : i32) -> i32 {
    (n + (r - 1)) / r * r
}

#[export]
fn make_image(buf : &mut [i8], width : i32, height : i32, x_min : f64, x_max : f64, y_min : f64, y_max : f64) -> () {

    let acc = cuda_accelerator(0);

    let pixel_cuda_buffer = acc.alloc(sizeof[u8]() * width as i64 * height as i64 * 3 : i64);
    let pixel_cuda = bitcast[&mut [u8]](pixel_cuda_buffer.data);

    // Scale max_iter with zoom depth so detail is preserved when zooming in
    let extent = x_max - x_min;
    let mut max_iter_tmp = (256 + 128 * math_builtins::log2(3.0 / extent)) as i32;

    if (max_iter_tmp < 256) {
        max_iter_tmp = 256;
    }
    if (max_iter_tmp > 2048) {
        max_iter_tmp = 2048;
    }

    let max_iter = max_iter_tmp;

    //Mandelbrot, F64
    /*for work_item in acc.exec((width_grid, height_grid, 1), (8, 8, 1)) {
        let px = work_item.gidx();
        let py = work_item.gidy();

        if (px < width && py < height) {
            let cr = x_min + (x_max - x_min) * (px as f64) / (width as f64);
            let ci = y_min + (y_max - y_min) * (py as f64) / (height as f64);
            let mut zr = 0.0 : f64;
            let mut zi = 0.0 : f64;
            let mut iter = 0;

            while (zr*zr + zi*zi <= 4.0 && iter < max_iter) {
                let tmp = zr*zr - zi*zi + cr;
                zi = 2.0*zr*zi + ci;
                zr = tmp;
                ++iter;
            }

            let pixel = bitcast[&mut [u8]](&mut pixel_cuda((py * width + px) * 3));
            if (iter == max_iter) {
                pixel(0) = 0;
                pixel(1) = 0;
                pixel(2) = 0;
            } else {
                let t = (iter as f64) / (max_iter as f64);
                pixel(0) = (9   * (1-t) * t*t*t * 255) as u8;
                pixel(1) = (15  * (1-t)*(1-t) * t*t * 255) as u8;
                pixel(2) = (8.5 * (1-t)*(1-t)*(1-t) * t * 255) as u8;
            }
        }
    }//*/

    //Mandelbrot, F64
    let width_grid = round_up(width, 8);
    let height_grid = round_up(height, 8);

    for work_item in acc.exec((width_grid, height_grid, 1), (8, 8, 1)) {
        let px = work_item.gidx();
        let py = work_item.gidy();

        if (px < width && py < height) {
            let cr = x_min as f32 + (x_max - x_min) as f32 * (px as f32) / (width as f32);
            let ci = y_min as f32 + (y_max - y_min) as f32 * (py as f32) / (height as f32);
            let mut zr = 0.0 : f32;
            let mut zi = 0.0 : f32;
            let mut iter = 0;

            while (zr*zr + zi*zi <= 4.0 && iter < max_iter) {
                let tmp = zr*zr - zi*zi + cr;
                zi = 2.0*zr*zi + ci;
                zr = tmp;
                ++iter;
            }

            let pixel = bitcast[&mut [u8]](&mut pixel_cuda((py * width + px) * 3));
            if (iter == max_iter) {
                pixel(0) = 0;
                pixel(1) = 0;
                pixel(2) = 0;
            } else {
                let t = (iter as f32) / (max_iter as f32);
                pixel(0) = (9   * (1-t) * t*t*t * 255) as u8;
                pixel(1) = (15  * (1-t)*(1-t) * t*t * 255) as u8;
                pixel(2) = (8.5 * (1-t)*(1-t)*(1-t) * t * 255) as u8;
            }
        }
    }//*/

    runtime_copy(pixel_cuda_buffer.device, pixel_cuda_buffer.data, 0, 0, buf, 0, pixel_cuda_buffer.size);
    release(pixel_cuda_buffer);
}

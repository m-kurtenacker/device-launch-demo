#[import(cc = "thorin")] fn cuda_launch_device(_dev: i32, _grid: (i32, i32, i32), _block: (i32, i32, i32), _body: fn() -> ()) -> ();

fn @round_up(n : i32, r : i32) -> i32 {
    (n + (r - 1)) / r * r
}

struct Point {
    x : f32,
    y : f32
}

fn @within_one_pixel (a : Point, b : Point, c : Point, width : f32, height : f32, x_min : f32, x_max : f32, y_min : f32, y_max : f32) {
    let pixel_x_a = ((a.x - x_min as f32) / (x_max - x_min) as f32 * width as f32) as i32;
    let pixel_y_a = ((a.y - y_min as f32) / (y_max - y_min) as f32 * height as f32) as i32;

    let pixel_x_b = ((b.x - x_min as f32) / (x_max - x_min) as f32 * width as f32) as i32;
    let pixel_y_b = ((b.y - y_min as f32) / (y_max - y_min) as f32 * height as f32) as i32;

    let pixel_x_c = ((c.x - x_min as f32) / (x_max - x_min) as f32 * width as f32) as i32;
    let pixel_y_c = ((c.y - y_min as f32) / (y_max - y_min) as f32 * height as f32) as i32;

    pixel_x_a == pixel_x_b && pixel_x_b == pixel_x_c && pixel_y_a == pixel_y_b && pixel_y_b == pixel_y_c
}

fn @center_point(a : Point, b : Point) -> Point {
    let x = (a.x + b.x) / 2.0;
    let y = (a.y + b.y) / 2.0;

    Point { x = x, y = y }
}


fn @cross2d(a : Point, b : Point) -> f32 {
    a.x * b.y - a.y * b.x
}

fn @is_inside_edge(e0 : Point, e1 : Point, p : Point) -> bool {
    let ep1 = Point { x = p.x - e0.x, y = p.y - e0.y };
    let ep2 = Point { x = p.x - e1.x, y = p.y - e1.y };
    cross2d(ep1, ep2) > 0
}

fn draw_point(a : Point, buf : &mut [i8], width : i32, height : i32, x_min : f64, x_max : f64, y_min : f64, y_max : f64) -> () {
    let px = ((a.x - x_min as f32) / (x_max - x_min) as f32 * width as f32) as i32;
    let py = ((a.y - y_min as f32) / (y_max - y_min) as f32 * height as f32) as i32;

    if 0 <= px && px < width && 0 <= py && py < height {
        let pixel = bitcast[&mut [u8]](&mut buf((py * width + px) * 3));

        pixel(0) = 255;
        pixel(1) = 0;
        pixel(2) = 0;
    }
}

fn fill_triangle(a : Point, b : Point, c : Point, buf : &mut [i8], width : i32, height : i32, x_min : f64, x_max : f64, y_min : f64, y_max : f64) -> () {
    for px in range(0, width) {
        for py in range(0, height) {
            let x = x_min as f32 + (x_max - x_min) as f32 * px as f32 / width as f32;
            let y = y_min as f32 + (y_max - y_min) as f32 * py as f32 / height as f32;

            let p = Point { x = x, y = y };

            if is_inside_edge(b, a, p) && is_inside_edge(c, b, p) && is_inside_edge(a, c, p) {
                let pixel = bitcast[&mut [u8]](&mut buf((py * width + px) * 3));

                pixel(0) = 0;
                pixel(1) = 0;
                pixel(2) = 255;
            }
        }
    }

    draw_point(a, buf, width, height, x_min, x_max, y_min, y_max);
    draw_point(b, buf, width, height, x_min, x_max, y_min, y_max);
    draw_point(c, buf, width, height, x_min, x_max, y_min, y_max);
}

fn render_triangle(a : Point, b : Point, c : Point, buf : &mut [i8], width : i32, height : i32, x_min : f64, x_max : f64, y_min : f64, y_max : f64, limit : i32) -> () {
    if within_one_pixel(a, b, c, width as f32, height as f32, x_min as f32, x_max as f32, y_min as f32, y_max as f32) {
        let px = ((a.x - x_min as f32) / (x_max - x_min) as f32 * width as f32) as i32;
        let py = ((a.y - y_min as f32) / (y_max - y_min) as f32 * height as f32) as i32;

        if 0 <= px && px < width && 0 <= py && py < height {
            let pixel = bitcast[&mut [u8]](&mut buf((py * width + px) * 3));

            pixel(0) = 255;
            pixel(1) = 0;
            pixel(2) = 0;
        }
    } else if limit == 0 {
        fill_triangle(a, b, c, buf, width, height, x_min, x_max, y_min, y_max);
    } else {
        let cab = center_point(a, b);
        let cac = center_point(a, c);
        let cbc = center_point(b, c);

        render_triangle(a, cab, cac, buf, width, height, x_min, x_max, y_min, y_max, limit - 1);
        render_triangle(b, cbc, cab, buf, width, height, x_min, x_max, y_min, y_max, limit - 1);
        render_triangle(c, cac, cbc, buf, width, height, x_min, x_max, y_min, y_max, limit - 1);
    }
}

